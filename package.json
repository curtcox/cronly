{
  "name": "cronly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --config wrangler.local.toml --local",
    "deploy": "wrangler deploy",
    "lint": "eslint src scripts frontend workers test-utils --no-error-on-unmatched-pattern",
    "check:file-sizes": "node scripts/check-file-sizes.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production:browser": "node scripts/verify-production-browser.mjs",
    "test:local": "node scripts/verify-local.mjs",
    "test:sandbox:live": "node scripts/verify-sandbox-live.mjs",
    "test:sandbox:runtime": "node scripts/probe-sandbox-live.mjs",
    "docs:generate": "node scripts/generate-openapi.mjs && node scripts/sdk-integrity.mjs",
    "legal:generate": "node scripts/operator-profile.mjs",
    "legal:check": "node scripts/operator-profile.mjs --check",
    "eval:prose": "node scripts/eval-prose.mjs",
    "secrets:rotate": "node scripts/rotate-secrets.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@clerk/backend": "2.33.9",
    "croner": "9.1.0",
    "cronstrue": "2.59.0",
    "stripe": "14.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "eslint": "8.57.1",
    "vitest": "5.0.3",
    "wrangler": "4.153.0"
  }
}
